# Copy to .env. Values with VITE_ are browser-visible; never put secrets there.
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Realtime SFU credentials. Both are server-only and are consumed
# exclusively by src/lib/cloudflare-realtime.functions.ts.
CF_REALTIME_APP_ID=""
CF_REALTIME_APP_TOKEN=""
# Optional HMAC key for browser session tickets; otherwise the service key is used.
CLASSROOM_TICKET_SECRET=""
