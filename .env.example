# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard > Project Settings > API).
#
# THIS FILE IS COMMITTED TO GIT — it is a template only. Real keys go in `.env`,
# which is gitignored. Anything pasted here becomes public.

# --- Shared / server-side ---
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# --- Client-side (VITE_ prefix = inlined into the browser bundle) ---
# These mirror the values above. The publishable/anon key is safe to expose;
# it is protected by row-level security.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Server-only secret ---
# Bypasses row-level security. Must NEVER get a VITE_ prefix and must never
# reach the client bundle. Used only by src/lib/classrooms.functions.ts.
# Without it, subject pages still work but classrooms are not auto-created.
SUPABASE_SERVICE_ROLE_KEY=""

# --- TURN relay (video) ---
# STUN alone only connects peers that can reach each other directly. On campus
# wifi or mobile data most cannot, and without a relay those pairs silently
# fail — one person sees another but not the reverse.
#
# Comma-separate multiple URLs. Any provider works: Cloudflare Realtime,
# Twilio, Metered, or self-hosted coturn.
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# --- Classroom video (Cloudflare Realtime SFU) ---
# Cloudflare's SFU is the only video backend. Create an app at
# dash.cloudflare.com > Realtime > SFU. See CLOUDFLARE-SFU.md.
#
# Free allowance is 1,000 GB of egress per month, then $0.05/GB. Only traffic
# Cloudflare sends to clients is billed, so publishing costs nothing.
CF_REALTIME_APP_ID=""
# Server-only. NEVER give this a VITE_ prefix: anyone holding it can create
# sessions and pull any track in the app.
CF_REALTIME_APP_TOKEN=""

# Signs the short-lived ticket that lets the browser make follow-up Cloudflare
# calls without re-running the full Supabase check each time. Optional — falls
# back to SUPABASE_SERVICE_ROLE_KEY. Any long random string works.
CLASSROOM_TICKET_SECRET=""
