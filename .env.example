# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard > Project Settings > API).
#
# THIS FILE IS COMMITTED TO GIT — it is a template only. Real keys go in `.env`,
# which is gitignored. Anything pasted here becomes public.

# --- Shared / server-side ---
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# --- Client-side (VITE_ prefix = inlined into the browser bundle) ---
# These mirror the values above. The publishable/anon key is safe to expose;
# it is protected by row-level security.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Server-only secret ---
# Bypasses row-level security. Must NEVER get a VITE_ prefix and must never
# reach the client bundle. Used only by src/lib/classrooms.functions.ts.
# Without it, subject pages still work but classrooms are not auto-created.
SUPABASE_SERVICE_ROLE_KEY=""

# --- TURN relay (video) ---
# STUN alone only connects peers that can reach each other directly. On campus
# wifi or mobile data most cannot, and without a relay those pairs silently
# fail — one person sees another but not the reverse.
#
# Comma-separate multiple URLs. Any provider works: Cloudflare Realtime,
# Twilio, Metered, or self-hosted coturn.
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# --- Classroom video backend ---
# Pathwaay's own mediasoup SFU (github.com/ninadaradhye-code/Pathwaay-SFU).
# When this is set it is used instead of LiveKit; leave it empty for LiveKit.
# Server-only: it is handed to the browser by classroom-video.functions.ts
# after that student has been authorised, so it needs no VITE_ prefix.
#
# Local development: http://localhost:3000 (the SFU's default port) works as-is,
# because the SFU already allows the http://localhost:5173 origin that
# `npm run dev` serves from.
#
# Production needs the SFU itself changed first — it is LAN-only today:
#   1. announcedIp must be the server's PUBLIC ip, not LAN_IP
#   2. its CORS allowlist must include https://kaenyon.vercel.app
#   3. it must be served over TLS, or a https page cannot open wss:// to it
#   4. UDP and TCP 40000-49999 must be open
SFU_URL=""

# --- LiveKit (used when SFU_URL is empty) ---
# Create a free project at livekit.io, then Settings > Keys.
#
# LiveKit is an SFU: each browser sends one upload to the server, which forwards
# it to everyone. That is what makes ~30 participants work — peer-to-peer needed
# one upload per person. Video renders in our own page, so there is no iframe:
# the public Jitsi servers were unusable because meet.jit.si demands a login and
# meet.ffmuc.net blocks embedding with frame-ancestors.
LIVEKIT_URL="wss://<project>.livekit.cloud"
LIVEKIT_API_KEY=""
# Server-only. NEVER give this a VITE_ prefix — it signs join tokens.
LIVEKIT_API_SECRET=""
