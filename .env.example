# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard > Project Settings > API).
#
# THIS FILE IS COMMITTED TO GIT — it is a template only. Real keys go in `.env`,
# which is gitignored. Anything pasted here becomes public.

# --- Shared / server-side ---
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# --- Client-side (VITE_ prefix = inlined into the browser bundle) ---
# These mirror the values above. The publishable/anon key is safe to expose;
# it is protected by row-level security.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Server-only secret ---
# Bypasses row-level security. Must NEVER get a VITE_ prefix and must never
# reach the client bundle. Used only by src/lib/classrooms.functions.ts.
# Without it, subject pages still work but classrooms are not auto-created.
SUPABASE_SERVICE_ROLE_KEY=""

# --- TURN relay (video) ---
# STUN alone only connects peers that can reach each other directly. On campus
# wifi or mobile data most cannot, and without a relay those pairs silently
# fail — one person sees another but not the reverse.
#
# Comma-separate multiple URLs. Any provider works: Cloudflare Realtime,
# Twilio, Metered, or self-hosted coturn.
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# --- Jitsi classroom (video) ---
# Public Jitsi instance by default. Point this at your own deployment to
# migrate — no code change is needed:
#   VITE_JITSI_DOMAIN="video.pathwaay.com"
#
# NOT meet.jit.si: it puts guests on an anonymous domain that cannot start a
# room, so every class would need a Google-authenticated host and everyone else
# waits in a lobby. meet.ffmuc.net allows open rooms, but it is a volunteer-run
# community server — fine for testing, self-host before real classes.
VITE_JITSI_DOMAIN="meet.ffmuc.net"
# Salts the hash that turns a classroom id into a Jitsi room name. NOT a secret
# (VITE_ vars ship to the browser) — it only keeps our database ids out of a
# third party and makes room names unguessable. Change it and everyone in a
# room must rejoin, so set it once.
VITE_JITSI_ROOM_SALT="pathwaay-classroom-v1"
