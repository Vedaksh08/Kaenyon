# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard > Project Settings > API). `.env` is gitignored — never commit real keys.

# --- Shared / server-side ---
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# --- Client-side (VITE_ prefix = inlined into the browser bundle) ---
# These mirror the values above. The publishable/anon key is safe to expose;
# it is protected by row-level security.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Server-only secret ---
# Bypasses row-level security. Must NEVER get a VITE_ prefix and must never
# reach the client bundle. Used only by src/lib/classrooms.functions.ts.
# Without it, subject pages still work but classrooms are not auto-created.
SUPABASE_SERVICE_ROLE_KEY=""
